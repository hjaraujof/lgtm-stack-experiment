# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data, such as
# password, private keys, and other secrets. These should not be part of version 
# control as they are data points which are potentially sensitive and subject 
# to change depending on the environment.
*.tfvars
*.tfvars.json

# Ignore override files as they are usually used to override resources locally and so
# are not checked in
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore transient lock info files created by terraform apply
.terraform.tfstate.lock.info

# Include override files you do wish to add to version control using negated pattern
# !example_override.tf

# Include tfplan files to ignore the plan output of command: terraform plan -out=tfplan
# example: *tfplan*
tofuplan

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Claude
.claude/sessions/
.claude/settings.local.json
.claude/pr-drafts/
.claude/logs/
.claude/handoffs/
.claude/screenshots/
.claude/worktrees/

# Generated knowledge-graph indexes. A personal core.excludesfile only protects the machine
# that has it, so a shared repo needs these committed.
graphify-out/
.codegraph/

# Local environment secrets (generated by scripts/setup-local-env.sh).
# `.env.*` too: a hand-written .env.local or .env.prod is the same hazard.
.env
.env.*
!.env.example
.verify-logs/

# Key and certificate material. This stack works with Let's Encrypt output and
# the docs suggest mkcert for local SSL, so these file types WILL appear in a
# working tree. One line each -- gitignore silently drops a malformed line.
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx
*.jks
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
htpasswd
certs/
letsencrypt/

# Config backups created during on-box deploys (e.g. *.bak.preC, *.bak.pretop3).
# These are transient on-disk backups, not config; keep them out of git.
*.bak
*.bak.*

# Cline specific files (development assistance tooling, not part of the stack)
.clinerules
memory-bank/

# Ignore contents of data directory, but keep the directory
data/*
!data/.gitkeep

# NGINX conf.d is rendered at deploy time by scripts/render-nginx-ssl.sh and
# bind-mounted into the container. The rendered output is not source.
config/nginx/conf.d/*
!config/nginx/conf.d/.gitkeep
