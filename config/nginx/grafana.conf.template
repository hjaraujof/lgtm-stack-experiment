# Grafana NGINX Configuration
# This file is generated by init-certbot.sh based on SSL certificate availability

server {
    listen 80;
    server_name ${DOMAIN_NAME};

    # Let's Encrypt ACME challenge
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # Redirect all HTTP traffic to HTTPS (when SSL is enabled)
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN_NAME};

    # SSL certificates (managed by certbot)
    ssl_certificate /etc/letsencrypt/live/${DOMAIN_NAME}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN_NAME}/privkey.pem;

    # SSL configuration (Mozilla Intermediate)
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:50m;
    ssl_session_tickets off;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;

    # HSTS (optional, uncomment if you want strict HTTPS)
    # add_header Strict-Transport-Security "max-age=63072000" always;

    # Fix for HTTP/2 protocol errors with large responses
    proxy_buffer_size 128k;
    proxy_buffers 4 256k;
    proxy_busy_buffers_size 256k;

    # RE-RESOLVE THE GRAFANA HOSTNAME PER REQUEST, via Docker's embedded DNS at 127.0.0.11.
    #
    # A plain `proxy_pass http://grafana:3000` resolves the name ONCE, at config load. When the
    # grafana container is recreated on a deploy it gets a NEW container IP, nginx keeps hitting the
    # dead old one, and every request answers 502. A VARIABLE in proxy_pass forces nginx to consult
    # the resolver on each request instead, which removes that whole failure class.
    #
    # These are declared at SERVER scope so every location inherits them. They belong here rather
    # than inside `location /`: nginx does not share directives between sibling locations, so the
    # guarded location below would otherwise need a verbatim copy of all of it — and a copy is a
    # thing that drifts.
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $grafana_upstream grafana;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Port $server_port;

    # WebSocket support for Grafana Live
    proxy_read_timeout 86400;

    # --- Write guards on the git-deployed alerting config ---
    #
    # Both of these proxy paths reach configuration whose source of truth is this repo, so a write
    # through the browser is DRIFT BY DEFINITION.
    #
    #   /api/alertmanager/mimir-alertmanager/config/  Mimir's Alertmanager config API. A write here
    #       can replace the tenant config with an empty one and kill ALL alert delivery, silently.
    #       See docs/runbooks/alert-delivery-silent.md.
    #   /api/ruler/Mimir-Prometheus/  the Mimir ruler. Read-only by design, because
    #       config/mimir/rules/ is the deploy path. Grafana still renders Edit and Delete on those
    #       groups and offers no setting to hide them, so fail the write at the edge rather than let
    #       it reach a backend that half-answers.
    #
    # SCOPED TO THESE EXACT DATASOURCE UIDs ON PURPOSE. A blanket `^/api/(alertmanager|ruler)/` would
    # also block uid `grafana`, which is how Grafana manages its OWN built-in Alertmanager contact
    # points and Grafana-managed rules — a capability nobody asked to remove. The UIDs are pinned in
    # config/grafana/provisioning/datasources/datasources.yaml. If one is renamed there, rename it
    # here, or this guard silently stops applying.
    #
    # GET and HEAD still pass, so viewing contact points, notification policies and rules is
    # unaffected. Silences are NOT touched: they are Alertmanager STATE under /api/v2/silences, not
    # config.
    #
    # THIS CLOSES THE BROWSER-FACING PATH ONLY. Any port that is open to the network and bypasses
    # this proxy — Grafana's own :3000, or a backend's API port — remains writable, and no nginx rule
    # can change that. The AlertmanagerConfigChanged alert is what covers the remainder.
    location ~ ^/api/(alertmanager/mimir-alertmanager/config|ruler/Mimir-Prometheus)/ {
        limit_except GET HEAD {
            deny all;
        }
        proxy_pass http://$grafana_upstream:3000;
    }

    # Proxy to Grafana
    location / {
        proxy_pass http://$grafana_upstream:3000;
    }
}
