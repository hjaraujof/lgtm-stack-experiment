    {
      "datasource": {
        "type": "prometheus",
        "uid": "Mimir-Prometheus"
      },
      "description": "Receiver drop ratio: refused / (accepted + refused). 0 is healthy, and a HEALTHY 0 MUST STILL BE VISIBLE - that is the whole point of this panel. The dashed lines are the 0.1% and 1% thresholds; thresholdsStyle is set explicitly because this panel colours by palette-classic (three series need three colours) and under that colour mode a threshold step paints nothing. axisSoftMin is NEGATIVE on purpose: with min:0 a series sitting at exactly 0 draws on the axis floor, is clipped, and the panel reads as EMPTY - which defeats clamp_min, since the reader still cannot tell healthy-zero from no-data. A hair of headroom below zero floats the line clear of the axis. axisSoftMax keeps the 1% limit on screen; both are SOFT, so a real excursion still rescales the axis. The clamp_min(.., 1) prevents 0/0 while ingest is quiet. LIMIT OF THIS PANEL: it covers the RECEIVER hop only. A downstream rejection (Tempo trace_too_large, Mimir duplicate-timestamp) never touches these counters and reads perfectly healthy here - see the two discard panels in the row above.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "percentunit",
          "custom": {
            "thresholdsStyle": {
              "mode": "dashed"
            },
            "axisSoftMin": -0.0015,
            "axisSoftMax": 0.01,
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.001
              },
              {
                "color": "red",
                "value": 0.01
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 30
      },
      "id": 10,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Mimir-Prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(otelcol_receiver_refused_spans_total[5m])) / clamp_min(sum(rate(otelcol_receiver_accepted_spans_total[5m])) + sum(rate(otelcol_receiver_refused_spans_total[5m])), 1)",
          "legendFormat": "spans",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Mimir-Prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(otelcol_receiver_refused_metric_points_total[5m])) / clamp_min(sum(rate(otelcol_receiver_accepted_metric_points_total[5m])) + sum(rate(otelcol_receiver_refused_metric_points_total[5m])), 1)",
          "legendFormat": "metric points",
          "range": true,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Mimir-Prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(otelcol_receiver_refused_log_records_total[5m])) / clamp_min(sum(rate(otelcol_receiver_accepted_log_records_total[5m])) + sum(rate(otelcol_receiver_refused_log_records_total[5m])), 1)",
          "legendFormat": "log records",
          "range": true,
          "refId": "C"
        }
      ],
      "title": "Receiver drop ratio (0 = healthy)",
      "type": "timeseries"
    },
    {
